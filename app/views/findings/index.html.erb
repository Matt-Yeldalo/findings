<div class="findings-index-container">
  <h1>Your Findings</h1>
  <div class="actions-container">
    <%= link_to new_finding_path do %>
      <%= inline_svg_tag "plus.svg" %>
      Create new finding
    <% end %>
  </div>

  <div class="findings-list">
    <%= render Finding::FindingComponent.with_collection(@findings) %>
  </div>
</div>
